# Normalize text files; use LF by default
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle Wrapper scripts
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary